#!/bin/bash

read -p "Host do banco: " DB_HOST
read -p "Nome do banco: " DB_NAME
read -p "Usuário do banco: " DB_USER
read -s -p "Senha do banco: " PGPASSWORD
echo

export PGPASSWORD

echo "Atualizando subscription_status para active..."

psql -h "$DB_HOST" -U "$DB_USER" -d "$DB_NAME" <<'SQL'
UPDATE users
SET subscription_status = 'active';
SQL

echo "Atualização concluída."
