#!/bin/bash

set -e


#ends
API_DIR="/root/frontscale/artifacts/api-server"
BASHRC="/root/.bashrc"
SCRIPT_FILE="/usr/local/bin/update-wa-version.sh"
CRON_LOG="/var/log/update-wa-version.log"

apt update
apt install -y cron
systemctl enable cron
systemctl start cron

cat > "$SCRIPT_FILE" <<'EOF'
#!/bin/bash

set -e

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/root/.local/share/pnpm:/root/.npm-global/bin

API_DIR="/root/frontscale/artifacts/api-server"
BASHRC="/root/.bashrc"

echo "[$(date)] Verificando versão do WhatsApp Web..."

NEW_VERSION=$(
cd "$API_DIR"

pnpm exec node --input-type=module -e '
import { fetchLatestBaileysVersion } from "@whiskeysockets/baileys";

const result = await fetchLatestBaileysVersion();
console.log(result.version.join("."));
'
)

if [ -z "$NEW_VERSION" ]; then
    echo "Erro: não foi possível obter a versão."
    exit 1
fi

# pega versão atual direto do ambiente carregado (bashrc)
CURRENT_VERSION=$(grep '^export WA_VERSION=' "$BASHRC" 2>/dev/null | cut -d= -f2 | tr -d '"' || true)

echo "Versão atual: ${CURRENT_VERSION:-não definida}"
echo "Versão nova : $NEW_VERSION"

if [ "$CURRENT_VERSION" = "$NEW_VERSION" ]; then
    echo "Nenhuma alteração necessária."
    exit 0
fi

# atualiza bashrc (persistência real)
if grep -q '^export WA_VERSION=' "$BASHRC"; then
    sed -i "s/^export WA_VERSION=.*/export WA_VERSION=$NEW_VERSION/" "$BASHRC"
else
    echo "" >> "$BASHRC"
    echo "export WA_VERSION=$NEW_VERSION" >> "$BASHRC"
fi

echo "WA_VERSION atualizada no bashrc: $NEW_VERSION"

# 🔥 RECARREGA AMBIENTE PARA ESTE PROCESSO
set -a
source "$BASHRC"
set +a

echo "Ambiente recarregado no script"

# 🔥 RELOAD SEGURO (ZERO OVERKILL)
if command -v pm2 >/dev/null 2>&1; then
    echo "Recarregando PM2 com novo ambiente..."
    pm2 reload all --update-env
    echo "PM2 recarregado com sucesso."
else
    echo "PM2 não encontrado."
fi

echo "Concluído."
EOF

chmod +x "$SCRIPT_FILE"

(
crontab -l 2>/dev/null | grep -v "$SCRIPT_FILE" || true
echo "0 3 * * * /bin/bash $SCRIPT_FILE >> $CRON_LOG 2>&1"
) | crontab -

echo "Cron instalado com sucesso"

"$SCRIPT_FILE"
